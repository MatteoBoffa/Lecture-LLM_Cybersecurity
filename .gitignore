# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Build outputs (regenerate with tools/build_site.py)
pdf/
site.zip
node_modules/

# site/ IS committed: it is the prebuilt viewer that makes `python3 display.py`
# work with no toolchain at all. Its heavy downloads are not.
site/*.pdf
site/*-offline.zip

# The offline archive carries its own launcher and notes; the committed viewer
# is served by display.py at the repository root and does not need a copy.
site/display.py
site/README.txt

# Private teaching notes
offline_notes/

.DS_Store

# Traces are build artifacts, except the lecture ones: shipping them means a
# student can open the lecture without re-running the models.
var/*
!var/traces
var/traces/*
!var/traces/[0-9][0-9]_*.json

# Lab data: downloaded on demand by labs/labs_lib.py, never committed.
labs/data/

# The CyberSleuth lab's evidence, downloaded on demand like the rest.
labs/cybersleuth/evidence/
# ...and the agent the students write themselves in Part 5.
labs/cybersleuth/.opencode/agents/sleuth-offline.md

# The worked labs, answers included: off GitHub until after the class.
# Delete this line to publish them.
labs/*/solutions/
