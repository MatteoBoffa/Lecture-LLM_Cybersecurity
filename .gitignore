# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Build outputs (regenerate with tools/build_site.py)
pdf/
site.zip
node_modules/

# site/ IS committed: it is the prebuilt viewer that makes `python3 display.py`
# work with no toolchain at all. Its heavy downloads are not.
site/*.pdf
site/*-offline.zip

# Private teaching notes
offline_notes/

.DS_Store

# Traces are build artifacts, except the lecture ones: shipping them means a
# student can open the lecture without re-running the models.
var/*
!var/traces
var/traces/*
!var/traces/[0-9][0-9]_*.json

# Superseded by the MP4 the lecture actually uses, and 23 MB on its own
images/Huawei_usecase.gif
