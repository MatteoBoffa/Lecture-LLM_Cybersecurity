       window.MathJax.typeset();
     }
   }, [renderedContent]);  // If put this, then don't update; otherwise too slow
diff --git a/frontend/src/index.css b/frontend/src/index.css
index 5b699c5..9a0e876 100644
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -50,6 +50,20 @@ button {
   word-wrap: break-word;
 }
 
+/* Raw Python lines sit on a light panel with a left rail, so code reads as a
+   block distinct from the rendered prose.  Lines that were replaced by a
+   rendering, and blank lines, are deliberately left alone. */
+.line:not(:has(.renderings)):has(> span > .code-container:not(:empty)) {
+  background-color: #f6f8fa;
+  box-shadow: inset 3px 0 0 #c9d3de;
+}
+
+/* Re-assert the cursor highlight: it has to win over the code panel above. */
+.line.current-line:not(:has(.renderings)):has(> span > .code-container:not(:empty)),
+.line.current-line {
+  background-color: #FFFFCC;
+}
+
 .current-line {
   background-color: #FFFFCC;
 }
